class SellWasteScreen extends StatefulWidget {
  @override
  _SellWasteScreenState createState() => _SellWasteScreenState();
}

class _SellWasteScreenState extends State<SellWasteScreen> {
  String selectedType = 'Plastic';
  double weight = 0.0;

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text('Sell Waste')),
      body: Column(
        children: [
          DropdownButton<String>(
            value: selectedType,
            items: ['Plastic', Metal', 'Paper']
                .map((type) => DropdownMenuItem(value: type, child: Text(type)))
                .toList(),
            onChanged: (value) => setState(() => selectedType = value!),
          ),
          TextField(
            keyboardType: TextInputType.number,
            onChanged: (val) => weight = double.tryParse(val) ?? 0.0,
            decoration: InputDecoration(labelText: 'Weight (kg)'),
          ),
          ElevatedButton(
            onPressed: () {
              // Call Firebase function here
              print("Waste submitted: $selectedType, $weight kg");
            },
            child: Text('Request Pickup'),
          )
        ],
      ),
    );
  }
}
class Waste {
  final String type;
  final double weight;
  final String imageUrl;

  Waste({required this.type, required this.weight, required this.imageUrl});
}import 'package:flutter/material.dart';

class WasteCard extends StatelessWidget {
  final String type;
  final double weight;

  WasteCard({required this.type, required this.weight});

  @override
  Widget build(BuildContext context) {
    return Card(
      child: ListTile(
        title: Text("Type: $type"),
        subtitle: Text("Weight: ${weight.toStringAsFixed(2)} kg"),
      ),
    );
  }
}
